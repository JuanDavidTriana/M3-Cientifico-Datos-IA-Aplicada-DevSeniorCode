# Copia este archivo a ".env" y ajusta los valores para tu entorno.
# El ".env" real NUNCA se sube al repositorio (ver ../README.md, sección 9.2).

# Ruta al modelo TFLite que carga app/model_utils.py.
# Si no se define, se usa la ruta por defecto: model/modelo_optimizado.tflite
MODEL_PATH=model/modelo_optimizado.tflite

# Nivel de logging de la aplicación
LOG_LEVEL=INFO
